# Local development configuration. Copy this file to .env and change the secret/password.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_COOKIE_SECURE=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

DB_NAME=cloudnotes
DB_USER=cloudnotes_app
DB_PASSWORD=change-this-local-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional: set DATABASE_ENGINE=sqlite to run the backend without MySQL while learning.
# DATABASE_ENGINE=sqlite
